<?xml version="1.0" encoding="UTF-8"?>
<!-- PHPUnit's settings for the SDK's specs, which scripts/test.sh runs: every spec under tests/, after
     tests/bootstrap.php strips every variable shaped like a credential, and a spec that warns, is
     risky or finds no spec to run fails the run. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         beStrictAboutOutputDuringTests="true"
         failOnEmptyTestSuite="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="specs">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
            <directory>examples</directory>
        </include>
    </source>
</phpunit>
